#!/usr/bin/env bash
# Vietnam Agentic Skills (VAS) CLI wrapper
# Author: Huy Tran (https://github.com/huytran1120)

TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
  DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
  TARGET="$(readlink "$TARGET")"
  [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
exec python3 "$DIR/vas.py" "$@"
